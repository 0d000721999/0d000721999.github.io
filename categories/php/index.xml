&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-php" data-lang="php">&lt;span class="line">&lt;span class="cl">&lt;span class="nv">$a&lt;/span> &lt;span class="o">=&lt;/span> &lt;span class="s1">&amp;#39;O:4:&amp;#34;test&amp;#34;:1:{s:1:&amp;#34;a&amp;#34;;s:3:&amp;#34;abc&amp;#34;;}&amp;#39;&lt;/span>&lt;span class="p">;&lt;/span> &lt;span class="c1">//+号绕过
&lt;/span>&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="c1">&lt;/span>&lt;span class="nv">$b&lt;/span> &lt;span class="o">=&lt;/span> &lt;span class="nx">str_replace&lt;/span>&lt;span class="p">(&lt;/span>&lt;span class="s1">&amp;#39;O:4&amp;#39;&lt;/span>&lt;span class="p">,&lt;/span>&lt;span class="s1">&amp;#39;O:+4&amp;#39;&lt;/span>&lt;span class="p">,&lt;/span> &lt;span class="nv">$a&lt;/span>&lt;span class="p">);&lt;/span>
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>过滤对象&lt;code>O:&lt;/code>：C绕过，&lt;del>例题忘了在哪里刷到过了&lt;/del>&lt;/p>
