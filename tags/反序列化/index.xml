&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="k">echo&lt;/span> &lt;span class="s2">&amp;#34;bypass&amp;#34;&lt;/span>&lt;span class="p">;&lt;/span>
