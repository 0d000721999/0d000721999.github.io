&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-fallback" data-lang="fallback">&lt;span class="line">&lt;span class="cl">cd /etc
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">echo &amp;#34;10.10.182.111 bricks.thm&amp;#34; &amp;gt;&amp;gt;hosts
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">cat hosts
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>然后nmap扫端口&lt;/p>
